---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---
<BaseLayout title="Home">
  <section class="max-w-7xl mx-auto px-6 md:px-10 min-h-[85vh] flex flex-col justify-center py-20 relative">
    <div class="absolute top-20 right-10 w-px h-32 bg-gradient-to-b from-transparent via-(--accent) to-transparent animate-pulse-accent hidden md:block"></div>

    <p class="text-xs uppercase tracking-[0.2em] text-(--accent) mb-6 animate-fade-in-up">Hi, I'm Salman Kabir — Full Stack Developer</p>

    <h1 class="font-display text-6xl md:text-7xl lg:text-8xl text-(--text-primary) leading-[1.02] animate-fade-in-up">
      I build <span class="font-accent text-(--accent)">fast, scalable</span><br />
      products &amp; experiences.
    </h1>

    <p class="mt-8 max-w-xl text-(--text-secondary) leading-relaxed animate-fade-in-up-delay-1">
      Full stack developer specializing in TypeScript, React, Astro, and Cloudflare infrastructure. Turning complex problems into clean, performant web applications.
    </p>

    <div class="mt-10 flex gap-8 animate-fade-in-up-delay-2">
      <a href="/projects" class="group text-sm uppercase tracking-[0.2em] text-(--accent) hover:text-(--accent-hover) transition-colors duration-300">
        View Work <span class="inline-block group-hover:translate-x-1 transition-transform duration-300">→</span>
      </a>
      <a href="/contact" class="group text-sm uppercase tracking-[0.2em] text-(--text-muted) hover:text-(--text-primary) transition-colors duration-300">
        Get in Touch <span class="inline-block group-hover:translate-x-1 transition-transform duration-300">→</span>
      </a>
    </div>

    <div class="mt-14 flex items-center gap-6 animate-fade-in-up-delay-3">
      <span class="w-px h-8 bg-(--border)"></span>
      <a href="https://github.com/Salmankabir12" target="_blank" rel="noopener noreferrer" class="group text-xs uppercase tracking-[0.2em] text-(--text-muted) hover:text-(--accent) transition-colors duration-300">
        GitHub <span class="text-(--accent)">↗</span>
      </a>
      <a href="https://www.linkedin.com/in/salmaaaankabir" target="_blank" rel="noopener noreferrer" class="group text-xs uppercase tracking-[0.2em] text-(--text-muted) hover:text-(--accent) transition-colors duration-300">
        LinkedIn <span class="text-(--accent)">↗</span>
      </a>
      <span class="flex items-center gap-2 text-xs text-(--text-muted)">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        Available
      </span>
    </div>
  </section>

  <section class="border-y border-(--border) py-6 overflow-hidden bg-(--surface-elevated)">
    <div class="flex animate-marquee whitespace-nowrap">
      {[
        ...["TypeScript","React","Astro","Cloudflare","Node.js","Tailwind","Sanity"],
        ...["TypeScript","React","Astro","Cloudflare","Node.js","Tailwind","Sanity"],
      ].map((item, i) => (
        <span key={i} class="flex items-center">
          <span class="mx-8 text-sm text-(--text-secondary)">{item}</span>
          <span class="text-(--accent)">✦</span>
        </span>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 md:px-10 py-24 fade-in">
    <div class="flex items-center gap-4 mb-2">
      <span class="text-xs uppercase tracking-[0.2em] text-(--text-muted)">Selected Work</span>
      <div class="flex-1 h-px bg-(--border)"></div>
      <span class="text-xs font-mono text-(--text-muted)">{String(projects.length).padStart(2, '0')} projects</span>
    </div>
    <div class="border-t border-(--border)">
      {projects.map((p, i) => (
        <a href={`/projects/${p.slug}`} class="group block border-b border-(--border) py-10 md:py-14 transition-all duration-500 relative">
          <div class="absolute inset-0 bg-(--surface-elevated) opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10 grid md:grid-cols-12 gap-4 md:gap-8 items-center">
            <span class="md:col-span-1 text-xs font-mono text-(--text-muted)">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="md:col-span-7 font-display text-3xl md:text-5xl text-(--text-primary) group-hover:text-(--accent) transition-colors duration-300">
              {p.title}
            </h3>
            <div class="md:col-span-3 text-sm text-(--text-muted)">
              <p class="line-clamp-1">{p.techStack.join(' · ')}</p>
            </div>
            <span class="md:col-span-1 text-right text-(--text-muted) group-hover:text-(--accent) transition-all duration-300 group-hover:translate-x-1 text-xl">
              →
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 md:px-10 py-24 border-t border-(--border) fade-in">
    <div class="flex items-center gap-4 mb-2">
      <span class="text-xs uppercase tracking-[0.2em] text-(--text-muted)">Expertise</span>
      <div class="flex-1 h-px bg-(--border)"></div>
    </div>
    <h2 class="font-display text-5xl md:text-6xl text-(--text-primary) mb-12">Skills &amp; Tools</h2>
    <div class="grid md:grid-cols-2 gap-0">
      {[
        { label: "Languages", items: ["TypeScript", "JavaScript", "Python", "C++"] },
        { label: "Frameworks", items: ["React", "Astro", "Vue", "Nuxt", "Node.js"] },
        { label: "Infrastructure", items: ["Cloudflare Workers", "Cloudflare Pages", "Vercel"] },
        { label: "Data & CMS", items: ["Sanity", "Strapi", "Cloudflare D1", "SQLite"] },
        { label: "Styling", items: ["Tailwind CSS", "CSS Custom Properties"] },
        { label: "AI & ML", items: ["Python", "Autograd", "Neural Networks", "scikit-learn"] },
      ].map((cat) => (
        <div class="flex gap-6 py-5 border-b border-(--border) group hover:bg-(--surface-elevated)/50 transition-colors duration-300 px-2 -mx-2">
          <span class="text-xs uppercase tracking-[0.2em] text-(--text-muted) w-28 shrink-0 pt-1 group-hover:text-(--accent) transition-colors duration-300">{cat.label}</span>
          <div class="flex flex-wrap gap-x-3 gap-y-1">
            {cat.items.map((item) => (
              <span class="text-sm text-(--text-secondary)">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 md:px-10 py-24 border-t border-(--border) fade-in">
    <div class="flex items-center gap-4 mb-2">
      <span class="text-xs uppercase tracking-[0.2em] text-(--text-muted)">Open Source</span>
      <div class="flex-1 h-px bg-(--border)"></div>
    </div>
    <h2 class="font-display text-5xl md:text-6xl text-(--text-primary) mb-12">GitHub</h2>
    <div class="flex flex-col items-start gap-6">
      <div class="flex gap-3">
        <a href="https://github.com/salmankabir12" class="group">
          <img src="https://img.shields.io/github/followers/salmankabir12?style=flat-square&logo=github&label=Followers&color=e8b65a" alt="Followers" class="opacity-80 group-hover:opacity-100 transition-all duration-300 group-hover:scale-105" />
        </a>
        <a href="https://github.com/salmankabir12" class="group">
          <img src="https://img.shields.io/github/stars/salmankabir12?style=flat-square&logo=github&label=Stars&color=e8b65a" alt="Stars" class="opacity-80 group-hover:opacity-100 transition-all duration-300 group-hover:scale-105" />
        </a>
      </div>
      <a href="https://github.com/salmankabir12" class="block w-full group">
        <img src="https://github-readme-activity-graph.vercel.app/graph?username=salmankabir12&theme=react-dark&hide_border=true&area=true&bg_color=0a0a0a&color=c9c9c9&line=e8b65a&point=e8b65a" alt="Activity Graph" class="w-full max-w-3xl border border-(--border) group-hover:border-(--accent)/50 transition-all duration-300" />
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.fade-in, .slide-in-left').forEach((el) => {
    observer.observe(el);
  });
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { sanityClient } from '../../lib/sanity'
import { getAllPostsQuery } from '../../lib/queries'
import type { Post } from '../../types/blog'

const posts = await sanityClient.fetch(getAllPostsQuery)
---

<BaseLayout title="Blog">
  <section class="max-w-5xl mx-auto px-6 md:px-10 py-20">
    <div class="flex items-center gap-4 mb-2">
      <span class="text-xs uppercase tracking-[0.2em] text-(--text-muted)">Writing</span>
      <div class="flex-1 h-px bg-(--border)"></div>
      <span class="text-xs font-mono text-(--text-muted)">{String(posts.length).padStart(2, '0')} posts</span>
    </div>
    <h1 class="font-display text-5xl md:text-6xl text-(--text-primary) mb-12 animate-fade-in-up">From the desk</h1>

    {posts.length === 0 ? (
      <p class="text-(--text-muted)">No posts yet. Check back soon.</p>
    ) : (
      <div class="border-t border-(--border)">
        {posts.map((post: Post, i: number) => (
          <a href={`/blog/${post.slug.current}`} class="group block border-b border-(--border) py-8 md:py-10 transition-all duration-500 relative">
            <div class="absolute inset-0 bg-(--surface-elevated) opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative z-10 grid md:grid-cols-12 gap-4 md:gap-8 items-center">
              <span class="md:col-span-1 text-xs font-mono text-(--text-muted)">{String(i + 1).padStart(2, '0')}</span>
              <div class="md:col-span-7">
                <h2 class="font-display text-2xl md:text-3xl text-(--text-primary) group-hover:text-(--accent) transition-colors duration-300">
                  {post.title}
                </h2>
                {post.excerpt && (
                  <p class="text-sm text-(--text-muted) mt-2 line-clamp-1">{post.excerpt}</p>
                )}
              </div>
              <span class="md:col-span-3 text-xs text-(--text-muted) font-mono">
                {new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </span>
              <span class="md:col-span-1 text-right text-(--text-muted) group-hover:text-(--accent) transition-all duration-300 group-hover:translate-x-1 text-xl">
                →
              </span>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

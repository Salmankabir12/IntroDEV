---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About">
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-20">
    <div class="flex items-center gap-4 mb-2">
      <span class="text-xs uppercase tracking-[0.2em] text-(--text-muted)">Narrative</span>
      <div class="flex-1 h-px bg-(--border)"></div>
    </div>
    <h1 class="font-display text-5xl md:text-6xl text-(--text-primary) mb-16 animate-fade-in-up">
      A developer who cares about <span class="font-accent text-(--accent)">craft</span> &amp; <span class="font-accent text-(--accent)">performance</span>.
    </h1>

    <div class="grid md:grid-cols-2 gap-16 items-start">
      <div class="w-full bg-(--surface-elevated) border border-(--border) font-mono animate-fade-in-up-delay-1 hover:border-(--accent)/30 transition-colors duration-300">
        <div class="flex items-center gap-1.5 px-4 py-3 border-b border-(--border)">
          <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
          <span class="ml-2 text-(--text-muted) text-[10px]">about.js</span>
        </div>
        <pre class="px-4 py-4 text-[12px] leading-relaxed whitespace-pre-wrap text-(--text-muted)"><code><span style="color:#ff7b72">const</span> <span style="color:#d2a8ff">salman</span> <span style="color:#ff7b72">=</span> <span style="color:#79c0ff">{'{'}</span>
  <span style="color:#ffa657">location</span>: <span style="color:#a5d6ff">'Dhaka, Bangladesh'</span>,
  <span style="color:#ffa657">code</span>: [<span style="color:#a5d6ff">'TypeScript'</span>, <span style="color:#a5d6ff">'JavaScript'</span>, <span style="color:#a5d6ff">'Python'</span>, <span style="color:#a5d6ff">'C++'</span>],
  <span style="color:#ffa657">web</span>: [<span style="color:#a5d6ff">'Astro'</span>, <span style="color:#a5d6ff">'React'</span>, <span style="color:#a5d6ff">'Node.js'</span>, <span style="color:#a5d6ff">'Tailwind CSS'</span>],
  <span style="color:#ffa657">databases</span>: [<span style="color:#a5d6ff">'SQLite'</span>, <span style="color:#a5d6ff">'Sanity CMS'</span>, <span style="color:#a5d6ff">'Cloudflare D1'</span>],
  <span style="color:#ffa657">cloud</span>: [<span style="color:#a5d6ff">'Cloudflare Workers'</span>, <span style="color:#a5d6ff">'Cloudflare Pages'</span>, <span style="color:#a5d6ff">'Vercel'</span>],
  <span style="color:#ffa657">tools</span>: [<span style="color:#a5d6ff">'Git'</span>, <span style="color:#a5d6ff">'npm'</span>, <span style="color:#a5d6ff">'pnpm'</span>, <span style="color:#a5d6ff">'VS Code'</span>],
  <span style="color:#ffa657">askMeAbout</span>: [<span style="color:#a5d6ff">'web dev'</span>, <span style="color:#a5d6ff">'full-stack architecture'</span>, <span style="color:#a5d6ff">'cloudflare'</span>, <span style="color:#a5d6ff">'machine learning'</span>, <span style="color:#a5d6ff">'autograd'</span>],
  <span style="color:#ffa657">ai</span>: [<span style="color:#a5d6ff">'Python'</span>, <span style="color:#a5d6ff">'Autograd'</span>, <span style="color:#a5d6ff">'Neural Networks'</span>, <span style="color:#a5d6ff">'Machine Learning'</span>],
  <span style="color:#ffa657">currentFocus</span>: <span style="color:#a5d6ff">'Building an autograd engine from scratch and full-stack web apps'</span>,
  <span style="color:#ffa657">funFact</span>: <span style="color:#a5d6ff">'I built an autograd engine from scratch to understand what .backward() really does'</span>,
<span style="color:#79c0ff">{'}'}</span>;</code></pre>
      </div>

      <div class="animate-fade-in-up-delay-2">
        <h2 class="font-display text-4xl text-(--text-primary) mb-6">Salman Kabir</h2>
        <div class="space-y-5 text-(--text-secondary) leading-relaxed">
          <p>
            Full stack developer focused on building performant and user-friendly applications. I specialize in modern web technologies, from architecting scalable backends to crafting polished frontend experiences.
          </p>
          <p>
            I work extensively with TypeScript, React, Node.js, and Cloudflare Workers, building performant applications deployed at the edge. I believe in clean architecture, type-safe code, and developer experience.
          </p>
          <p>
            Currently building an autograd engine from scratch to deeply understand automatic differentiation and neural network fundamentals.
          </p>
        </div>

        <div class="mt-10 border-t border-(--border) pt-8">
          <p class="text-xs uppercase tracking-[0.2em] text-(--text-muted) mb-4">Currently</p>
          <p class="text-(--text-secondary)">Building an autograd engine from scratch and full-stack web apps.</p>
        </div>

        <div class="mt-8 flex gap-6">
          <a href="https://github.com/Salmankabir12" target="_blank" rel="noopener noreferrer" class="group text-sm text-(--text-secondary) hover:text-(--accent) transition-colors duration-300">
            GitHub <span class="inline-block group-hover:translate-x-1 transition-transform duration-300">→</span>
          </a>
          <a href="https://www.linkedin.com/in/salmaaaankabir" target="_blank" rel="noopener noreferrer" class="group text-sm text-(--text-secondary) hover:text-(--accent) transition-colors duration-300">
            LinkedIn <span class="inline-block group-hover:translate-x-1 transition-transform duration-300">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

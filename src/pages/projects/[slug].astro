---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudentPredictor from '../../components/StudentPredictor';
import { projects } from '../../data/projects';

const project = projects.find(p => p.slug === Astro.params.slug)
const index = projects.findIndex(p => p.slug === Astro.params.slug)

if (!project) {
  return Astro.redirect('/projects', 404)
}
---

<BaseLayout title={project.title}>
  <article class="max-w-4xl mx-auto px-6 md:px-10 py-20">
    <div class="flex items-center justify-between mb-8">
      <a href="/projects" class="group inline-flex items-center text-xs uppercase tracking-[0.2em] text-(--text-muted) hover:text-(--accent) transition-colors duration-300">
        <span class="inline-block group-hover:-translate-x-1 transition-transform duration-300">←</span>
        <span class="ml-2">Projects</span>
      </a>
      <span class="text-xs font-mono text-(--text-muted)">{String(index + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}</span>
    </div>

    <h1 class="font-display text-5xl md:text-6xl text-(--text-primary) mt-8 mb-4 animate-fade-in-up">
      {project.title}
    </h1>

    <p class="text-sm text-(--text-secondary) mb-10 animate-fade-in-up-delay-1">{project.techStack.join(' · ')}</p>

    <div class="flex flex-wrap gap-8 mb-10 animate-fade-in-up-delay-2">
      {project.liveUrl && (
        <a href={project.liveUrl} target="_blank" class="group text-sm text-(--accent) hover:text-(--accent-hover) transition-colors duration-300">
          View Live <span class="inline-block group-hover:translate-x-1 transition-transform duration-300">→</span>
        </a>
      )}
      {project.githubUrl && (
        <a href={project.githubUrl} target="_blank" class="group text-sm text-(--text-secondary) hover:text-(--accent) transition-colors duration-300">
          GitHub <span class="text-(--text-muted)">↗</span>
        </a>
      )}
    </div>

    <div class="border-t border-(--border) pt-10 animate-fade-in-up-delay-2">
      <p class="text-(--text-secondary) leading-[1.8] text-lg">{project.content}</p>
    </div>

    {project.slug === 'ai-student-predictor' && (
      <div class="mt-12 border-t border-(--border) pt-10">
        <StudentPredictor client:load />
      </div>
    )}
  </article>
</BaseLayout>
